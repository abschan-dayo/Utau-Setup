{
  "name": "utau-setup",
  "productName": "ふっきんちゃんが一晩でやってくれました",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "check:privacy": "node scripts/check-privacy.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "build": "node scripts/check-privacy.mjs && tsc --noEmit && vite build",
    "prepackage:win": "npm run build",
    "package:win": "node scripts/package.mjs win32",
    "prepackage:win:portable": "npm run build",
    "package:win:portable": "node scripts/package-portable.mjs",
    "prepackage:mac": "npm run build",
    "package:mac": "node scripts/package.mjs darwin"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.utau-setup.desktop",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "electronDownload": {
      "cache": "node_modules/.cache/electron"
    },
    "directories": {
      "output": "release-portable"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "builtin-plugins/**/*",
      "plugin-template/**/*",
      "assets/icon.png",
      "assets/completion.wav",
      "assets/notifications/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
